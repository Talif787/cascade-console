    "eslint": "^9.17.0",
    "eslint-config-next": "^15.4.0",
    "eslint-plugin-storybook": "^0.11.1",
    "openapi-typescript": "^7.5.0",
    "prettier": "^3.4.2",
    "storybook": "8.6.18",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
